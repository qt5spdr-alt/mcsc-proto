<style>
*{box-sizing:border-box;margin:0;padding:0}
.csc-proto{font-family:system-ui,sans-serif;background:#f5f4f0;border-radius:12px;overflow:hidden;border:1px solid #e0dfd9}
.csc-topbar{background:#fff;border-bottom:1px solid #e0dfd9;padding:10px 16px;display:flex;align-items:center;gap:8px;flex-wrap:wrap}
.csc-grp{display:flex;align-items:center;gap:4px;cursor:pointer;padding:4px 8px;border-radius:6px;transition:background .15s}
.csc-grp:hover{background:#f0efe9}
.csc-grp.active{background:#e6f1fb}
.csc-num{width:18px;height:18px;border-radius:50%;background:#f0efe9;border:1px solid #d3d1c7;font-size:10px;font-weight:500;color:#6b6b67;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.csc-grp.active .csc-num{background:#1877F2;color:#fff;border-color:#1877F2}
.csc-glabel{font-size:11px;color:#6b6b67}
.csc-grp.active .csc-glabel{color:#185FA5;font-weight:500}
.csc-sep{font-size:11px;color:#ccc}
.csc-counter{font-size:11px;color:#aaa;margin-left:auto;white-space:nowrap}
.csc-hint{background:#f0efe9;border-bottom:1px solid #e0dfd9;padding:5px 16px;font-size:11px;color:#8c8b86;text-align:center}
.csc-screen{background:#111110;padding:28px 36px;display:flex;align-items:center;justify-content:center;min-height:400px}
.csc-img{max-width:100%;max-height:500px;border-radius:8px;display:block;box-shadow:0 2px 8px rgba(0,0,0,.4),0 16px 48px rgba(0,0,0,.5),0 0 0 .5px rgba(255,255,255,.07);object-fit:contain}
.csc-nav{background:#fff;border-top:1px solid #e0dfd9;padding:12px 16px;display:flex;align-items:center;justify-content:space-between;gap:8px}
.csc-caption{font-size:12px;color:#6b6b67;flex:1;text-align:center;line-height:1.4;padding:0 12px}
.csc-btn{display:flex;align-items:center;gap:5px;padding:7px 14px;border-radius:6px;border:1px solid #d3d1c7;background:#fff;color:#2c2c2a;font-size:13px;font-weight:500;cursor:pointer;transition:background .15s;font-family:system-ui,sans-serif;white-space:nowrap}
.csc-btn:hover{background:#f5f4f0}
.csc-btn:disabled{opacity:.3;cursor:not-allowed}
.csc-btn-p{background:#1877F2;color:#fff;border-color:#1877F2}
.csc-btn-p:hover{background:#1464cc;border-color:#1464cc}
</style>

<div class="csc-proto">
  <div class="csc-topbar">
    <div class="csc-grp active" id="cg0" onclick="cscGoGroup(0)"><div class="csc-num">1</div><span class="csc-glabel">Entry</span></div>
    <span class="csc-sep">›</span>
    <div class="csc-grp" id="cg1" onclick="cscGoGroup(3)"><div class="csc-num">2</div><span class="csc-glabel">3-step flow</span></div>
    <span class="csc-sep">›</span>
    <div class="csc-grp" id="cg2" onclick="cscGoGroup(7)"><div class="csc-num">3</div><span class="csc-glabel">Post-submit</span></div>
    <span class="csc-sep">›</span>
    <div class="csc-grp" id="cg3" onclick="cscGoGroup(11)"><div class="csc-num">4</div><span class="csc-glabel">Agent portal</span></div>
    <span class="csc-counter" id="cscCount">1 / 13</span>
  </div>
  <div class="csc-hint">End assignment early — Meta CSC · 13 screens</div>
  <div class="csc-screen" id="cscScreen"></div>
  <div class="csc-nav">
    <button class="csc-btn" id="cscPrev" onclick="cscGo(-1)" disabled>← prev</button>
    <span class="csc-caption" id="cscCap"></span>
    <button class="csc-btn csc-btn-p" id="cscNext" onclick="cscGo(1)">next →</button>
  </div>
</div>

<script>
var S=[
  {src:"https://images.squarespace-cdn.com/content/648d311a65728852ce0190ce/27942199-a9b7-4600-8522-6152c935c5a8/00_Manage+CSC+.png?content-type=image%2Fpng",label:"Worker list",caption:"CWAM lands on Manage contingent workers — 20 active assignments with status, subtype, and reporting manager"},
  {src:"https://images.squarespace-cdn.com/content/648d311a65728852ce0190ce/5518c4eb-4764-45cd-b4c8-ab68e71c01ce/00_Manage+CSC_End+Assignment.png?content-type=image%2Fpng",label:"End assignment action",caption:"Three-dot menu reveals contextual actions — 'End assignment' selected for Rafaela Fernandes"},
  {src:"https://images.squarespace-cdn.com/content/648d311a65728852ce0190ce/04e5c7ef-fbf9-409f-a398-3b47aa7ea429/00-1_Details+Panel.png?content-type=image%2Fpng",label:"Details panel",caption:"Side panel shows full assignment details — contract dates, cost center, team, and SRT info"},
  {src:"https://images.squarespace-cdn.com/content/648d311a65728852ce0190ce/15745f55-3698-4132-9acd-bf87728ec087/1_Choose+End+Assignment.png?content-type=image%2Fpng",label:"Step 1: Choose type",caption:"Step 1 of 3 — choose end assignment type: early vs. immediately, with clear consequence descriptions"},
  {src:"https://images.squarespace-cdn.com/content/648d311a65728852ce0190ce/35dc6090-f259-49f9-8476-1955db207186/2_End+Assignment+Early+Selected.png?content-type=image%2Fpng",label:"Early selected",caption:"'End assignment early' selected — highlighted state with blue fill, request title field editable"},
  {src:"https://images.squarespace-cdn.com/content/648d311a65728852ce0190ce/1b579bd2-b63c-45cf-8ecd-c016e3575989/3_Add+Details.png?content-type=image%2Fpng",label:"Step 2: Add details",caption:"Step 2 of 3 — current end date locked, updated date entered, reason from dropdown, optional notes"},
  {src:"https://images.squarespace-cdn.com/content/648d311a65728852ce0190ce/b52cf7ae-21d3-45c7-b003-22dd40feb99f/4_Summary.png?content-type=image%2Fpng",label:"Step 3: Summary",caption:"Step 3 of 3 — change highlighted: 01/26/2025 → 12/01/2024. Full review before submit"},
  {src:"https://images.squarespace-cdn.com/content/648d311a65728852ce0190ce/f1ba17f9-d815-44be-82f6-f3ac8969df72/5_Manage+CSC-Post+Offboarding.png?content-type=image%2Fpng",label:"Post-submit list",caption:"After submission — info badge on Rafaela's row indicates active change request in progress"},
  {src:"https://images.squarespace-cdn.com/content/648d311a65728852ce0190ce/36c7badc-047e-48fa-9e36-c55fdbbf442e/6_Manage+CSC-Post+Offboarding-Change+requests.png?content-type=image%2Fpng",label:"Change requests tab",caption:"Side panel Change requests tab — current request badged, past requests accessible"},
  {src:"https://images.squarespace-cdn.com/content/648d311a65728852ce0190ce/13ae912e-2b06-42fa-a871-23ff503df8af/7_Request+tracker.png?content-type=image%2Fpng",label:"Request tracker",caption:"3-step status tracker: Submitted → Review and approval (in progress) → Completed with timelines"},
  {src:"https://images.squarespace-cdn.com/content/648d311a65728852ce0190ce/9c14f6e0-e851-4242-b1a5-2ca704429afd/8_CSC+-+request+details+modal.png?content-type=image%2Fpng",label:"Request details modal",caption:"Expanded request detail — full change log, requester info, comments thread between CWAM and CWx"},
  {src:"https://images.squarespace-cdn.com/content/648d311a65728852ce0190ce/41fdf6b5-a634-4233-8a79-e4dce2b137b2/9_Agent+portal+-+Early+offboard-+request+details.png?content-type=image%2Fpng",label:"Agent portal: Forms",caption:"Agent view in BUY@ — Forms tab shows submitted request details for review with Action button"},
  {src:"https://images.squarespace-cdn.com/content/648d311a65728852ce0190ce/633c65a4-f6af-4115-8c30-c0f8433cd373/10_Agent+portal+-+Early+offboard-+request+details.png?content-type=image%2Fpng",label:"Agent portal: Status",caption:"Agent view in BUY@ — Status tab with 3-step tracker and estimated timelines. Comments persist"}
];

var cur=0;
var groups=[[0,2],[3,6],[7,10],[11,12]];

function cscRender(){
  var s=S[cur];
  document.getElementById('cscCount').textContent=(cur+1)+' / '+S.length;
  document.getElementById('cscCap').textContent=s.caption;
  document.getElementById('cscPrev').disabled=cur===0;
  var nb=document.getElementById('cscNext');
  nb.disabled=cur===S.length-1;
  nb.textContent=cur===S.length-1?'end':'next →';
  document.getElementById('cscScreen').innerHTML='<img class="csc-img" src="'+s.src+'" alt="'+s.label+'">';
  groups.forEach(function(r,i){
    var el=document.getElementById('cg'+i);
    if(cur>=r[0]&&cur<=r[1])el.classList.add('active');
    else el.classList.remove('active');
  });
}

function cscGo(d){cur=Math.max(0,Math.min(S.length-1,cur+d));cscRender();}
function cscGoGroup(n){cur=n;cscRender();}
cscRender();
</script>
